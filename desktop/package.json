{
  "name": "notepad-desktop",
  "productName": "Notepad Desktop",
  "version": "0.9.1",
  "description": "Text, code and queries \u2014 desktop editor by Ilya",
  "author": "Ilya (starscream001)",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "dist": "npm run build && electron-builder --publish never"
  },
  "build": {
    "appId": "io.github.starscream001.notepad-desktop",
    "productName": "Notepad Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "core.cjs",
      "ui/**",
      "package.json",
      "LICENSE",
      "assets/icon.png",
      "updates.cjs",
      "projects.cjs",
      "github-auth.cjs",
      "github-sync.cjs",
      "sync-core.cjs",
      "github-repository.cjs",
      "github-storage.cjs",
      "github-oauth.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Notepad-Desktop-${version}-Windows-x64-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "artifactName": "Notepad-Desktop-${version}-Linux-x64.${ext}",
      "maintainer": "Ilya (starscream001)",
      "desktop": {
        "entry": {
          "StartupWMClass": "notepad-desktop"
        }
      }
    },
    "mac": {
      "target": "zip",
      "icon": "assets/icon.png",
      "identity": null
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-python": "^6.2.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@codemirror/view": "^6.38.0",
    "dompurify": "^3.3.0",
    "marked": "18.1.3"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "sql-formatter": "^15.9.0"
  },
  "homepage": "https://github.com/starscream001/notepad_for_mac"
}
